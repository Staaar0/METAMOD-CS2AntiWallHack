import os
import runpy
from pathlib import Path

builder.AddConfigureFile(os.path.join(builder.sourcePath, "AntiWallHack.cfg"))
builder.AddConfigureFile(os.path.join(builder.sourcePath, "generate_defaults.py"))
runpy.run_path(os.path.join(builder.sourcePath, "generate_defaults.py"))
project = builder.LibraryProject(MMSPlugin.metadata["name"])
for sdk_target in MMSPlugin.sdk_targets:
    sdk = sdk_target.sdk
    binary = MMSPlugin.HL2Library(builder, sdk_target.cxx, project, sdk)
    binary.compiler.cxxincludes += [os.path.join(builder.sourcePath, "src")]
    binary.sources += sorted(
        p.relative_to(builder.sourcePath).as_posix() for p in (Path(builder.sourcePath) / "src").rglob("*.cpp")
    )
    binary.custom = [
        builder.tools.Protoc(
            protoc=sdk_target.protoc, sources=[os.path.join(sdk["path"], "common", "network_connection.proto")]
        )
    ]
MMSPlugin.tasks += builder.Add(project)
